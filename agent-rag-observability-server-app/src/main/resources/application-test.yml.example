# application-test.yml 示例模板（test profile）
# 复制为 application-test.yml 并填入真实值后使用

server:
  port: 8092
  servlet:
    context-path: /

spring:
  datasource:
    url: jdbc:mysql://${MYSQL_HOST:<your-host>}:${MYSQL_PORT:3306}/agent_observability?useUnicode=true&characterEncoding=utf-8&useSSL=false&serverTimezone=Asia/Shanghai
    username: ${MYSQL_USERNAME:<your-username>}
    password: ${MYSQL_PASSWORD:<your-password>}
    driver-class-name: com.mysql.cj.jdbc.Driver
    # ── PostgreSQL 切换模板（三期 PG 双轨，工单 0122）────────────────────
    # 切 PG 时将上方 url / driver-class-name 替换为：
    #   url: jdbc:postgresql://${POSTGRESQL_HOST:<your-host>}:${POSTGRESQL_PORT:5432}/agent_observability?currentSchema=public
    #   driver-class-name: org.postgresql.Driver
    # 建表脚本：sql/ 目录双方言 DDL（MySQL/PG）。
    # ─────────────────────────────────────────────────────────────────────
  elasticsearch:
    uris: ${ES_SCHEME:http}://${ES_HOST:<your-host>}:${ES_PORT:9200}
    username: ${ES_USERNAME:<your-username>}
    password: "${ES_PASSWORD:<your-password>}"
  data:
    redis:
      host: ${REDIS_HOST:<your-host>}
      port: ${REDIS_PORT:6379}

mybatis:
  mapper-locations: classpath:/mybatis/mapper/*.xml
  configuration:
    map-underscore-to-camel-case: true

elasticsearch:
  host: ${ES_HOST:<your-host>}
  port: ${ES_PORT:9200}
  scheme: ${ES_SCHEME:http}
  username: ${ES_USERNAME:<your-username>}
  password: "${ES_PASSWORD:<your-password>}"

rocketmq:
  name-server: ${ROCKETMQ_NAME_SERVER:<your-host>:9876}
  consumer:
    group: observability-consumer-group

observability:
  auth-key: <your-auth-key>
  mq:
    consumer:
      enabled: true
      topic: observability-trace
      group: observability-consumer-group

management:
  endpoints:
    web:
      exposure:
        include: prometheus, health, info
  metrics:
    export:
      prometheus:
        enabled: true
    tags:
      application: agent-observability

logging:
  level:
    root: info
    cn.chyuan.ai.observability: debug
