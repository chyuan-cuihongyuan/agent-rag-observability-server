server:
  port: 8092
  servlet:
    context-path: /
  # 优雅停机（D07）：等待在途请求完成再关闭（配合 MQ 消费摘流，E03 部分落地）
  shutdown: graceful

spring:
  lifecycle:
    timeout-per-shutdown-phase: 30s
  # AUTOLOOP al-24 / 工单 1024：虚拟线程开关（默认关；启用前读
  # docs/02-agent-rag-observability-server/虚拟线程启用评估.md 的分阶段建议）
  # threads:
  #   virtual:
  #     enabled: true
  datasource:
    url: jdbc:mysql://${MYSQL_HOST:<your-host>}:${MYSQL_PORT:3306}/agent_observability?useUnicode=true&characterEncoding=utf-8&useSSL=false&serverTimezone=Asia/Shanghai
    username: ${MYSQL_USERNAME:<your-username>}
    password: ${MYSQL_PASSWORD:<your-password>}
    driver-class-name: com.mysql.cj.jdbc.Driver
  elasticsearch:
    uris: ${ES_SCHEME:http}://${ES_HOST:<your-host>}:${ES_PORT:9200}
    username: ${ES_USERNAME:<your-username>}
    password: "${ES_PASSWORD:<your-password>}"
  data:
    redis:
      host: ${REDIS_HOST:<your-host>}
      port: ${REDIS_PORT:6379}
  # b-44：LLM 调用重试显性化（覆盖 spring-ai 默认 max-attempts 10、退避
  # 上限 3min——对用户面调用过激）；3 次 + 2s→10s 封顶。同步 application-dev.yml 本地面
  ai:
    retry:
      max-attempts: 3
      backoff:
        initial-interval: 2000
        multiplier: 2
        max-interval: 10000

mybatis:
  mapper-locations: classpath:/mybatis/mapper/*.xml
  configuration:
    map-underscore-to-camel-case: true

# springdoc-openapi（D06）：文档端点与分组
springdoc:
  api-docs:
    enabled: true
    path: /v3/api-docs
  swagger-ui:
    enabled: true
    path: /swagger-ui.html
    tags-sorter: alpha
    operations-sorter: alpha
  group-configs:
    - group: collect
      display-name: 采集上报（网关通道）
      paths-to-match: /api/v1/collect/**
    - group: query
      display-name: Trace 查询
      paths-to-match: /api/v1/query/**
    - group: eval
      display-name: 质量评测
      paths-to-match: /api/v1/eval/**
    - group: dashboard
      display-name: 监控仪表盘
      paths-to-match: /api/v1/dashboard/**,/api/v1/seed/**

elasticsearch:
  host: ${ES_HOST:<your-host>}
  port: ${ES_PORT:9200}
  scheme: ${ES_SCHEME:http}
  username: ${ES_USERNAME:<your-username>}
  password: "${ES_PASSWORD:<your-password>}"

rocketmq:
  name-server: ${ROCKETMQ_NAME_SERVER:<your-host>:9876}
  consumer:
    group: observability-consumer-group

observability:
  auth-key: <your-auth-key>
  mq:
    consumer:
      enabled: true
      topic: observability-trace
      group: observability-consumer-group

management:
  endpoints:
    web:
      exposure:
        include: prometheus, health, info
  # 存活/就绪探针（D07）：/actuator/health/liveness 与 /readiness，供 k8s/compose 探针
  endpoint:
    health:
      probes:
        enabled: true
  metrics:
    export:
      prometheus:
        enabled: true
    tags:
      application: agent-observability

logging:
  # 控制台/文件行含 traceId（D08：TraceIdFilter 与 MQ 消费端写入同一 MDC key）
  pattern:
    console: "%d{yyyy-MM-dd HH:mm:ss.SSS} %5p [%thread] [%X{traceId:-}] %logger{40} : %m%n"
    file: "%d{yyyy-MM-dd HH:mm:ss.SSS} %5p [%thread] [%X{traceId:-}] %logger{40} : %m%n"
  level:
    root: info
    cn.chyuan.ai.observability: debug
