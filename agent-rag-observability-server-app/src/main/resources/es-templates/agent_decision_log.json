{
  "settings": {
    "number_of_shards": 3,
    "number_of_replicas": 1,
    "refresh_interval": "5s"
  },
  "mappings": {
    "properties": {
      "traceId": {"type": "keyword"},
      "sourceService": {"type": "keyword"},
      "tenantId": {"type": "keyword"},
      "ownerUserId": {"type": "keyword"},
      "sessionId": {"type": "keyword"},
      "agentId": {"type": "keyword"},
      "userQuery": {"type": "text", "analyzer": "ik_max_word"},
      "intentType": {"type": "keyword"},
      "selectedToolList": {"type": "object", "enabled": true},
      "decisionReason": {"type": "text", "analyzer": "ik_max_word"},
      "branchType": {"type": "keyword"},
      "planSteps": {"type": "object", "enabled": true},
      "toolCallTimes": {"type": "integer"},
      "toolRetryTimes": {"type": "integer"},
      "agentStatus": {"type": "keyword"},
      "costTimeMs": {"type": "integer"},
      "modelVersion": {"type": "keyword"},
      "errorMessage": {"type": "text"},
      "createTime": {"type": "date", "format": "yyyy-MM-dd HH:mm:ss"}
    }
  }
}
