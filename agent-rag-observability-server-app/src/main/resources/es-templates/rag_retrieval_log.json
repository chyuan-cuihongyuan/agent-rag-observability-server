{
  "settings": {
    "number_of_shards": 3,
    "number_of_replicas": 1,
    "refresh_interval": "5s"
  },
  "mappings": {
    "properties": {
      "traceId": {"type": "keyword"},
      "sourceService": {"type": "keyword"},
      "tenantId": {"type": "keyword"},
      "ownerUserId": {"type": "keyword"},
      "sessionId": {"type": "keyword"},
      "agentId": {"type": "keyword"},
      "queryText": {"type": "text", "analyzer": "ik_max_word"},
      "rewriteText": {"type": "text", "analyzer": "ik_max_word"},
      "retrievalTopk": {"type": "integer"},
      "retrievalCount": {"type": "integer"},
      "sourceDocs": {"type": "keyword"},
      "rerankScores": {"type": "keyword"},
      "emptyRetrieval": {"type": "integer"},
      "retrievalCostMs": {"type": "integer"},
      "retrievalStages": {"type": "keyword"},
      "ragStrategyVersion": {"type": "keyword"},
      "createTime": {"type": "date", "format": "yyyy-MM-dd HH:mm:ss"}
    }
  }
}
